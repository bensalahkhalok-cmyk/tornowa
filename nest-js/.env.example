# Database Configuration
DATABASE_URL="postgresql://league_user:league_password@localhost:5432/league_db?schema=public"

# JWT Configuration
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production_minimum_32_chars"

# Server Configuration
PORT=3000
NODE_ENV="development"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000"

# Optional: Email Configuration (for notifications)
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT="587"
# MAIL_USER="your_email@gmail.com"
# MAIL_PASSWORD="your_app_password"
# MAIL_FROM="noreply@league.com"

# Optional: Firebase Configuration (for push notifications)
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"

# Optional: Payment Gateway (for future integration)
# PAYMENT_PROVIDER="stripe_or_payfort"
# PAYMENT_API_KEY="your_payment_api_key"
# PAYMENT_SECRET_KEY="your_payment_secret_key"
